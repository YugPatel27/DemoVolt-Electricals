# Copy this file to .env and adjust for your environment.

NODE_ENV=development
PORT=3001

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5000

# Optional overrides (defaults shown) — see server/config.js
# BODY_LIMIT=100kb
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# TRUST_PROXY=false

# Base URL of the frontend — used to build links in emails (e.g. password
# reset). Defaults to the first ALLOWED_ORIGINS entry if unset.
# FRONTEND_URL=http://localhost:5000

# Set both to create the first admin account on next server start (see
# server/bootstrap.js). There is deliberately no API endpoint for
# self-promotion to admin — this env-var bootstrap is the only way in.
# Remove these from .env again after the account is created.
ADMIN_EMAIL=admin@volampelectricals.com
ADMIN_BOOTSTRAP_PASSWORD= Yp@270405
